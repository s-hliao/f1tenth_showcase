# Fleet addressing for the showcase demo. This is the ONLY file to edit at the venue.
# Sourced by scripts/dds_env.sh (override the path with SHOWCASE_FLEET_ENV=/path/to/fleet.env).
#
# Cars are addressed by their static CMU-DEVICE hostnames, resolved when dds_env.sh is sourced,
# so DHCP address changes between sessions do not matter. IP literals also work.
CAR1_HOST=dl-car.wifi.local.cmu.edu                 # car1 (one car runs Foxy, the other Humble; both are fine)
CAR2_HOST=team10jetsonorin.wifi.local.cmu.edu       # car2
LAPTOP_HOST=spirit-of-fire.wifi.local.cmu.edu       # ground station (this dev machine); change if another laptop runs the GUI

# DDS domains. NET is shared over Wi-Fi by the relays and the laptop.
# LOCAL is loopback-only on each car: car1 uses LOCAL_DOMAIN_BASE, car2 LOCAL_DOMAIN_BASE+1
# (they never meet; distinct ids only matter for the single-machine desk test).
NET_DOMAIN=7
LOCAL_DOMAIN_BASE=42
